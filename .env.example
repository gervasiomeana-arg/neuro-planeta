# Production AI is locked until per-account authentication is implemented.
# GEMINI_API_KEY is only used by loopback development; never prefix it with VITE_.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional local server port (defaults to 3000)
PORT=3000


# Commercial preparation: off preserves current pilot access. Never use VITE_ for secrets.
PAYPAL_MODE=off
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# Public HTTPS origin, without paths, for checkout return and webhook URLs.
COMMERCIAL_APP_URL=https://neuroplaneta.ai.studio
# Private commercial review fields; never exposed in public config or policy text.
# Support is the internal adult Messages channel. Completing these alone is not legal approval.
LEGAL_ADDRESS=
SUPPORT_EMAIL=
# Keep false until sandbox + live acceptance tests and commercial review are complete.
BILLING_ENFORCE=false
COMMERCIAL_LIVE_REVIEWED=false
# Server-only random signing key (at least 32 characters) for short-lived asset access.
BILLING_ASSET_SECRET=
# Optional setup script; reuse UUID on retries and store returned public resource IDs.
PAYPAL_SETUP_REQUEST_ID=
PAYPAL_PRODUCT_ID=
# Firebase Admin uses the server's Application Default Credentials for neuroplaneta-bdaf9.
# Configure IAM on the server; do not put service-account JSON into browser code or GitHub.
