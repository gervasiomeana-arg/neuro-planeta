rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsFamily(familyId) {
      return request.auth != null
        && request.auth.uid == familyId
        && request.auth.token.email_verified == true;
    }
    function validMetadata(familyId) {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerUid', 'schemaVersion', 'createdAt', 'updatedAt'])
        && d.ownerUid == familyId && d.schemaVersion == 1
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function validProfile(familyId) {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerUid', 'schemaVersion', 'nickname', 'ageRange', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerUid', 'schemaVersion', 'nickname', 'ageRange', 'createdAt', 'updatedAt'])
        && d.ownerUid == familyId && d.schemaVersion == 1
        && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 60
        && d.ageRange in ['3-5', '6-8', '9-10']
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /families/{familyId} {
      allow get: if ownsFamily(familyId);
      allow list, delete: if false;
      allow create: if ownsFamily(familyId) && validMetadata(familyId)
        && request.resource.data.createdAt == request.time;
      allow update: if ownsFamily(familyId) && validMetadata(familyId)
        && request.resource.data.createdAt == resource.data.createdAt;
      match /profiles/{profileId} {
        allow get, delete: if ownsFamily(familyId);
        allow list: if ownsFamily(familyId) && request.query.limit <= 20;
        allow create: if ownsFamily(familyId) && validProfile(familyId)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsFamily(familyId) && validProfile(familyId)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
    // No membership invitations, photos, voices, clinical notes or other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
